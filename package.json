{
  "name": "lokus",
  "private": true,
  "type": "module",
  "description": "Lokus assessment platform running the NorthrSim Clinical Trial Associate simulation",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w @lokus/server\" \"npm run dev -w @lokus/client\"",
    "build": "npm run build -w @lokus/client && npm run build -w @lokus/server",
    "start": "node server/dist/server.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "db:generate": "npm run db:generate -w @lokus/server",
    "db:migrate": "npm run db:migrate -w @lokus/server",
    "db:seed": "npm run db:seed -w @lokus/server",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
