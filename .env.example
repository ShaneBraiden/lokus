# Lokus — environment variables. Copy to .env for local development (never commit .env).

# ---- Runtime --------------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the site (used in email links and the CSRF origin check).
APP_URL=http://localhost:5173

# ---- Database ---------------------------------------------------------------------------------------------------
# Production: Supabase "Session pooler" connection string (port 5432). Leave unset locally to use embedded PGlite in
# .data/pglite. Keep the production string out of this file (npm run dev reads it): put it in a separate gitignored
# file such as .env.supabase and pass --env=.env.supabase to db:check, db:migrate or db:seed.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# TLS for DATABASE_URL: off | no-verify | verify
# (default: verify when DATABASE_SSL_CA is set, no-verify for other remote hosts, off for localhost).
# DATABASE_SSL=no-verify
# CA certificate that signs the server's certificate (Supabase: Database settings > SSL configuration > Download
# certificate). Multi-line PEM, or one line with \n where the line breaks were.
# DATABASE_SSL_CA=
# PGLITE_DIR=.data/pglite

# ---- Security ---------------------------------------------------------------------------------------------------
# Required in production: at least 32 random characters (signs nothing client-side; encrypts TOTP secrets at rest).
# SESSION_SECRET=
# Require authenticator-app two-factor for Lokus staff (admin, assessor). Defaults to true in production.
# REQUIRE_STAFF_MFA=true
# Number of proxies in front of the app (Render: 1). Defaults to 1 in production.
# TRUST_PROXY=1

# ---- Email (Resend) ---------------------------------------------------------------------------------------------
# Without RESEND_API_KEY, emails (including verification and invite links) are printed to the API log.
# RESEND_API_KEY=
EMAIL_FROM=Lokus <no-reply@lokus.example>
# Every account (candidates, employers, staff) confirms its email via an emailed link before using its dashboard or
# starting an assessment. Default: on when RESEND_API_KEY is set, off otherwise (links then go to the API log).
# REQUIRE_EMAIL_VERIFICATION=true
# Testing phase (default: on): invitations, team invites, new organisations and staff accounts create the account
# straight away with DEFAULT_ACCOUNT_PASSWORD and no invitation is sent (with verification on, they still get a
# confirmation link). Set to false once Resend is set up.
# DIRECT_ACCOUNTS=false
# DEFAULT_ACCOUNT_PASSWORD=Lokus@2026
# Testing phase: every organisation's talent pool shows every submitted result (invited ones too). On by default.
# OPEN_TALENT_POOL=false

# ---- First admin (production bootstrap) ------------------------------------------------------------------------
# Created at startup when no account with this email exists. Remove the password after the first login.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ---- Local demo accounts (seeded into the embedded PGlite database in development) ------------------------------
# They share the password below, so they are not seeded into a DATABASE_URL unless SEED_DEMO=true. Never set it for a
# shared or production database.
# SEED_DEMO=true
DEV_DEMO_PASSWORD=Lokus@2026
DEV_ADMIN_EMAIL=admin@lokus.local
DEV_ASSESSOR_EMAIL=assessor@lokus.local
DEV_EMPLOYER_EMAIL=employer@lokus.local
DEV_CANDIDATE_EMAIL=candidate@lokus.local
